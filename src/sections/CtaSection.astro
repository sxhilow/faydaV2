---
import Section from "@components/Section.astro";
import Pill from "@components/Pill.astro";
import Button from "@components/Button.astro";
import ArrowIcon from "@assets/icons/arrow-top-right.svg";
---

<Section id="contact" className="bg-grey-2 relative">
    <div class="absolute inset-0 max-w-7xl mx-auto pointer-events-none z-0">
        <div class="h-full w-full border-x border-blue-50 relative">
            <!-- The connecting track that the ball will drop down -->
            <div
                data-cta-line
                class="absolute left-1/2 top-1/2 bottom-0 w-[1px] bg-blue-50 -translate-x-1/2 origin-top scale-y-0 hidden md:block z-10"
            >
            </div>
        </div>
    </div>

    <div
        data-cta
        class="relative z-50 h-screen mt-[-100vh] flex flex-col items-center justify-center bg-blue-500 px-8 lg:px-0 w-full"
    >
        <!-- We wrap the text content so GSAP can fade it out independently from the blue background -->
        <div data-cta-content class="flex flex-col items-center gap-8">
            <Pill label="The Origin" tone="blue" />

            <h2
                class="max-w-225 text-center font-display font-bold text-mobile-h1 text-grey-1 md:text-h1"
            >
                Everything starts with <br class="hidden lg:inline" />a single
                point.
            </h2>

            <Button
                label="Start a Project"
                iconPosition="right"
                className="w-full max-w-68.5"
            >
                <ArrowIcon slot="icon" class="h-4 w-4" />
            </Button>
        </div>
    </div>
</Section>
