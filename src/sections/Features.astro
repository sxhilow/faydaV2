---
import Section from "@components/Section.astro";
import SectionHeader from "@components/SectionHeader.astro";
import FeatureCard from "@components/FeatureCard.astro";
import { features } from "@constants/features.ts";
---

<Section
	id="features"
	className="relative xl:z-40 bg-grey-2 xl:mt-[-100vh]"
	style="--cards-gap: clamp(3rem, 10vh, 6rem)"
	data-overlapping
>
	<div
		data-features-cards
		class="relative max-w-7xl mx-5 flex flex-col gap-16 border-x border-blue-50 md:mx-6 xl:mx-auto pt-[--cards-gap] pb-[--cards-gap]"
	>
		<div class="flex w-full justify-end px-5 lg:px-8" data-fade-in-content>
			<SectionHeader
				pill="Why Fayda"
				title="Everything you need"
				description="A straightforward, honest process built around your business. Placeholder subheading — copy to be finalised."
			/>
		</div>
		<div
			data-fade-in-content
			data-features-grid
			class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 lg:grid-rows-[repeat(4,minmax(186px,auto))] lg:gap-0"
		>
			{features.map((feature) => <FeatureCard {...feature} />)}
		</div>
	</div>
</Section>
