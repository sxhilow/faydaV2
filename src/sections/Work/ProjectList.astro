---
import Section from "@components/ui/Section.astro";
import Button from "@components/ui/Button.astro";
import ProjectCard from "@components/cards/ProjectCard.astro";
import ProjectModals from "@components/modals/ProjectModals.astro";
import ArrowIcon from "@assets/icons/arrow-top-right.svg";
import { projects } from "@constants/projects.ts";

const INITIAL_VISIBLE = 3;
const LOAD_BATCH = 3;
---

<Section className="relative bg-grey-2 w-full px-5 xl:px-0">
	<div
		class="relative mx-auto w-full max-w-7xl border-x border-blue-50 py-20 xl:py-32"
	>
		<div class="flex flex-col" data-fade-in-content data-project-list>
			{
				projects.map((project, i) => (
					<div data-project-card {...(i >= INITIAL_VISIBLE ? { hidden: true } : {})}>
						<ProjectCard {...project} reverse={i % 2 === 1} />
					</div>
				))
			}
		</div>
		<div class="mt-16 flex justify-center" data-load-more-wrap>
			<Button label="Load More Projects" iconPosition="right" data-load-more data-batch={LOAD_BATCH}>
				<ArrowIcon slot="icon" class="h-4 w-4 rotate-45" />
			</Button>
		</div>
	</div>
	<ProjectModals />
</Section>

<script>
	import { initWorkLoadMore } from "@scripts/workLoadMore";

	initWorkLoadMore();
</script>
