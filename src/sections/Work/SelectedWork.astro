---
import Section from "@components/Section.astro";
import Pill from "@components/Pill.astro";
import { Image } from "astro:assets";
import { explorations } from "@constants/explorations.ts";
---

<Section className="relative bg-grey-2 w-full px-5 xl:px-0">
	<div
		class="relative mx-auto w-full max-w-7xl border-x border-blue-50 py-20 lg:py-32"
	>
		<div
			class="flex flex-col gap-4 items-start max-lg:px-5 md:items-center md:text-center"
			data-fade-in-content
		>
			<Pill label="More Exploration" />
			<h2 class="font-display font-semibold text-mobile-h2 text-grey-13 md:text-h2">
				Still exploring.
			</h2>
		</div>

		<div class="mt-16 grid grid-cols-1 md:grid-cols-2" data-fade-in-content>
			{
				explorations.map(({ image, tags }) => (
					<div class="flex flex-col items-center gap-4 border-t border-blue-50 p-8 md:odd:border-r">
						<Image
							src={image}
							alt="Concept exploration preview"
							class="aspect-[4/3] w-full border border-blue-50 object-cover shadow-card"
							widths={[640, 1280]}
							sizes="(min-width: 768px) 50vw, 100vw"
							loading="lazy"
						/>
						<ul class="flex flex-wrap justify-center gap-2">
							{tags.map((tag) => (
								<li>
									<Pill label={tag} size="sm" />
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</Section>
