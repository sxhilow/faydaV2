---
import Section from "@components/Section.astro";
import Pill from "@components/Pill.astro";
import FeatureCard from "@components/FeatureCard.astro";
import { features } from "@constants/features.ts";
---

<Section id="why-us" className="relative left-1/2 w-screen -translate-x-1/2 bg-blue-500">
		<div class="max-w-7xl mx-5 border-x border-blue-400 py-20 md:mx-6 lg:py-32 xl:mx-auto">
		<div class="flex flex-col items-center gap-4 text-center px-8 md:px-20">
			<Pill label="Why Fayda" tone="blue" />
			<h2 class="font-display font-semibold leading-[1.3] text-grey-2 text-mobile-h4 md:text-h3">
				At Fayda, we believe building a website should feel straightforward. Every project starts
				with understanding your business, your goals, and the people you're trying to reach. By
				keeping communication clear and staying closely involved throughout the process, we're able
				to create websites that not only look professional but help businesses build trust, stand
				out, and grow with confidence.
			</h2>
		</div>
		<div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 lg:grid-rows-[repeat(4,minmax(186px,auto))] lg:gap-0">
			{features.map((feature) => (
				<FeatureCard {...feature} />
			))}
		</div>
	</div>
</Section>
