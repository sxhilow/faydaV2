---
import Section from "@components/Section.astro";
import Pill from "@components/Pill.astro";
import FeatureCard from "@components/FeatureCard.astro";
import { features } from "@constants/features.ts";
---

<Section
	id="why-us"
	className="relative z-30 left-1/2 w-screen -translate-x-1/2 "
	style="--cards-gap: clamp(3rem, 10vh, 6rem)"
>
	<div
		class="why-us-pin relative min-h-screen flex flex-col items-center justify-center max-w-7xl mx-5 border-x border-blue-400 md:mx-6 xl:mx-auto"
	>
		<div class="flex flex-col items-center gap-4 text-center px-8 md:px-20">
			<Pill label="Why Fayda" tone="blue" invertible />
			<h2
				class="font-display font-semibold leading-[1.3] text-mobile-h4 md:text-h3"
			>
				<span class="text-blue-50">At Fayda, </span>
				<span class="text-blue-200" data-why-us-reveal>
					we believe building a website should feel straightforward.
					Every project starts with understanding your business, your
					goals, and the people you're trying to reach. By keeping
					communication clear and staying closely involved throughout
					the process, we're able to create websites that not only
					look professional but help businesses build trust, stand
					out, and grow with confidence.
				</span>
			</h2>
		</div>
	</div>
	<div
		data-why-us-cards
		class="relative max-w-7xl mx-5 border-x border-blue-400 md:mx-6 xl:mx-auto pt-[var(--cards-gap)] pb-[var(--cards-gap)]"
	>
		<div
			class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 lg:grid-rows-[repeat(4,minmax(186px,auto))] lg:gap-0"
		>
			{features.map((feature) => <FeatureCard {...feature} />)}
		</div>
	</div>
</Section>
