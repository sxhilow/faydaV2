---
import Section from "@components/Section.astro";
import SectionHeader from "@components/SectionHeader.astro";
import ServiceCard from "@components/ServiceCard.astro";
import { services } from "@constants/services.ts";
---

<Section id="services" className="px-5 xl:px-0" data-badge-target>
	<div
		class="relative max-w-7xl mx-auto border-x border-blue-50 flex flex-col items-center gap-16 py-20 lg:py-32 z-0"
	>
		<!-- The Continuous Background Track Line -->
		<div
			class="absolute left-1/2 top-0 bottom-0 w-px bg-blue-50 -translate-x-1/2 pointer-events-none -z-10 hidden xl:block"
		>
		</div>

		<div data-fade-in-content class="w-full lg:px-8 relative z-10">
			<SectionHeader
				pill="Our Services"
				title="What are you looking to build?"
				description="Whether you're starting from scratch or already have a website, there's a clear path forward."
				titleClassName="lg:max-w-[530px]"
			/>
		</div>

		<div data-fade-in-content class="flex w-full flex-col relative z-10">
			{services.map((service) => <ServiceCard {...service} />)}
		</div>
	</div>
</Section>
