---
import Section from "@components/ui/Section.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import ProjectCard from "@components/cards/ProjectCard.astro";
import ProjectModals from "@components/modals/ProjectModals.astro";
import { projects } from "@constants/projects.ts";

const recentProjects = projects.slice(0, 3);
---

<Section
	id="work"
	className="relative xl:z-40 bg-grey-2 overflow-hidden w-full px-5 xl:px-0 xl:-mt-[100vh]"
	data-recent-projects
>
	<div
		class="relative mx-auto w-full max-w-7xl border-x border-blue-50 py-20"
	>
		<div data-rp-content class="flex flex-col gap-16">
			<div data-fade-in-content data-rp-heading class="lg:px-8">
				<SectionHeader
					pill="Recent Projects"
					title="What We've Been Building"
					description="From client work to creative explorations, here's a look at what we've been building recently."
				/>
			</div>
			<div class="relative flex flex-col" data-fade-in-content data-rp-cards>
				{
					recentProjects.map((project) => (
						<div data-rp-card>
							<ProjectCard {...project} />
						</div>
					))
				}
			</div>
		</div>
	</div>
	<ProjectModals />
</Section>
