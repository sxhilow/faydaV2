---
import Section from "@components/ui/Section.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import FeatureCard from "@components/cards/FeatureCard.astro";
import { processSteps } from "@constants/process.ts";
---

<Section
	id="process"
	className="relative z-40 bg-grey-2"
	style="--cards-gap: clamp(3rem, 10vh, 6rem)"
>
	<div
		data-fade-in-content
		data-process-cards
		class="relative max-w-7xl mx-5 border-x border-blue-50 md:mx-6 xl:mx-auto pt-[var(--cards-gap)] pb-[var(--cards-gap)]"
	>
		<div data-process-reveal class="flex flex-col gap-16">
			<div class="flex w-full justify-end px-5 lg:px-8">
				<SectionHeader
					pill="How It Works"
					title="From first call to launch"
					description="A simple four-step process that keeps you informed from kickoff to launch."
				/>
			</div>
			<div
				data-fade-in-content
				data-process-grid
				class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 lg:grid-rows-[repeat(4,minmax(186px,auto))] lg:gap-0"
			>
				{processSteps.map((step) => <FeatureCard {...step} />)}
			</div>
		</div>
	</div>
</Section>
