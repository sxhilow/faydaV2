---
import Pill from "@components/Pill.astro";

interface Props {
	pill: string;
	title?: string;
	description?: string;
	className?: string;
	titleClassName?: string;
}

const {
	pill,
	title,
	description,
	className = "",
	titleClassName = "",
} = Astro.props;
---

<header class={`flex w-full flex-col gap-4 px-5 lg:px-0 ${className}`}>
	<Pill label={pill} />

	<div class="flex w-full flex-col gap-2 lg:flex-row lg:items-start lg:justify-between lg:gap-8">
		{title && (
			<h2
				class={`font-display font-semibold text-mobile-h2 text-grey-13 md:text-h2 ${titleClassName} max-w-xl`}
			>
				{title}
			</h2>
		)}

		{description && (
			<p class="max-w-105 text-body text-grey-10 ">
				{description}
			</p>
		)}
	</div>
</header>