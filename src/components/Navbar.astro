---
import LogoDark from "@assets/logo-dark.svg";
import MeetIcon from "@assets/icons/google-meet.svg";
import Button from "@components/Button.astro";
import { primaryNav as links } from "@constants/nav.ts";
---

<input type="checkbox" id="menu-toggle" class="peer sr-only" />
<header class="fixed inset-x-0 top-0 z-40 hidden lg:block">
	<div
		data-nav-secondary
		class="absolute inset-x-0 top-0 z-40"
	>
		<div class="mx-auto w-full max-w-5xl px-8 md:px-6 xl:px-0 ">
			<nav class="flex items-center justify-between gap-8 rounded-b-4xl bg-grey-2 px-8 py-4 border border-t-0 border-grey-5 shadow-card">
				<a href="#top" aria-label="Fayda Studio home" class="flex flex-1 items-center">
					<LogoDark class="block h-8 w-auto" />
				</a>
				<div class="flex items-center gap-8">
					{
						links.map((link) => (
							<a
								href={link.href}
								class="text-medium-sm font-medium text-grey-10 transition-colors duration-200 hover:text-grey-13"
							>
								{link.label}
							</a>
						))
					}
				</div>
				<div class="flex flex-1 justify-end">
					<Button label="Book a 15-Min Call">
						<MeetIcon slot="icon" class="h-3 w-[14px]" />
					</Button>
				</div>
			</nav>
		</div>
	</div>
</header>
<div
	id="mobile-menu"
	class="fixed inset-x-0 top-0 z-50 flex -translate-y-full flex-col bg-blue-500 px-8 pb-8 pt-28 transition-transform duration-500 ease-in-out peer-checked:translate-y-0 motion-reduce:transition-none lg:hidden"
>
	<nav aria-label="Mobile" class="mt-8 flex flex-col justify-center">
		{
			links.map((link) => (
				<label for="menu-toggle" class="cursor-pointer">
					<a
						href={link.href}
						class="block border-b border-blue-400 py-8 text-center font-display text-mobile-h2 font-semibold text-grey-1"
					>
						{link.label}
					</a>
				</label>
			))
		}

		<div class="mb-8 mt-auto pt-8 px-8">
			<label for="menu-toggle" class="block cursor-pointer">
				<Button label="Book a 15 min Call" className="w-full">
					<MeetIcon slot="icon" class="h-3 w-[14px]" />
				</Button>
			</label>
		</div>
	</nav>
</div>
