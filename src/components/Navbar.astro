---
import LogoDark from "@assets/logo-dark.svg";
import LogoLight from "@assets/logo-light.svg";
import MenuIcon from "@assets/icons/menu.svg";
import CloseIcon from "@assets/icons/close.svg";
import MeetIcon from "@assets/icons/google-meet.svg";
import Button from "@components/Button.astro";
import { primaryNav as links } from "@constants/nav.ts";
---

<header class="sticky top-0 z-40 border-b border-blue-50 bg-grey-2">
	<input type="checkbox" id="menu-toggle" class="peer sr-only" />
	<div class="mx-auto flex w-full max-w-7xl items-center px-8 py-8 md:px-6 xl:px-0">
		<a href="#top" aria-label="Fayda Studio home" class="flex flex-1">
			<LogoDark class="h-8 w-auto" />
		</a>
		<nav aria-label="Primary" class="hidden items-center gap-8 lg:flex">
			{links.map((link) => (
				<a href={link.href} class="text-medium-sm font-medium text-grey-10">{link.label}</a>
			))}
		</nav>
		<div class="hidden flex-1 justify-end lg:flex">
			<Button label="Book a 15-Min Call">
				<MeetIcon slot="icon" class="h-3 w-[14px]" />
			</Button>
		</div>
		<label for="menu-toggle" class="flex cursor-pointer items-center gap-2 lg:hidden" aria-label="Open menu">
			<span class="text-body-sm text-grey-10">Menu</span>
			<MenuIcon class="h-4 w-4" />
		</label>
	</div>
	<div class="fixed inset-0 z-50 hidden flex-col bg-blue-500 p-8 peer-checked:flex lg:hidden">
		<div class="flex items-center justify-between">
			<a href="#top" aria-label="Fayda Studio home">
				<LogoLight class="h-8 w-auto" />
			</a>
			<label for="menu-toggle" class="flex cursor-pointer items-center gap-2" aria-label="Close menu">
				<span class="text-body text-grey-1">Close</span>
				<CloseIcon class="h-4 w-4" />
			</label>
		</div>
		<nav aria-label="Mobile" class="mt-8 flex flex-col justify-center">
			{links.map((link) => (
				<label for="menu-toggle" class="cursor-pointer">
					<a
						href={link.href}
						class="block border-b border-blue-400 py-8 text-center font-display text-mobile-h2 font-semibold text-grey-1"
					>
						{link.label}
					</a>
				</label>
			))}
		</nav>
		<div class="mb-8 mt-auto pt-8">
			<label for="menu-toggle" class="block cursor-pointer">
				<Button label="Book a 15 min Call" className="w-full">
					<MeetIcon slot="icon" class="h-3 w-[14px]" />
				</Button>
			</label>
		</div>
	</div>
</header>
