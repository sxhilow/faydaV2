---
import ChevronIcon from "@assets/icons/chevron.svg";

interface Props {
    question: string;
    answer?: string;
}

const { question, answer } = Astro.props;
---

<div
    class="faq-item group relative border-b border-blue-50 last:border-b-0 p-6 lg:p-8 flex flex-col justify-center transition-colors duration-300 cursor-pointer"
    data-faq-item
>
    <!-- Middle line border highlight -->
    <div
        class="absolute -left-[1px] top-0 bottom-0 w-[2px] bg-blue-500 scale-y-0 group-[.is-active]:scale-y-100 group-hover:scale-y-100 origin-center transition-transform duration-500 hidden lg:block z-10"
    >
    </div>

    <h3
        class="font-sans text-medium font-medium text-grey-10 group-[.is-active]:text-blue-500 group-hover:text-blue-500 transition-colors duration-300 flex items-center justify-between gap-4"
    >
        {question}
        <span
            class="shrink-0 rotate-0 group-[.is-active]:rotate-180 transition-transform duration-500 lg:hidden"
        >
            <ChevronIcon class="h-4 w-4" />
        </span>
    </h3>

    {
        answer && (
            <div class="grid grid-rows-[0fr] opacity-0 group-[.is-active]:grid-rows-[1fr] group-hover:grid-rows-[1fr] group-[.is-active]:opacity-100 group-hover:opacity-100 group-[.is-active]:mt-4 group-hover:mt-4 transition-all duration-500 ease-in-out">
                <div class="overflow-hidden">
                    <p class="text-body-sm text-grey-8">{answer}</p>
                </div>
            </div>
        )
    }
</div>
