---
import Button from "@components/ui/Button.astro";
import MeetIcon from "@assets/icons/google-meet.svg";
import { footerNav as links, socials } from "@constants/nav.ts";
import Logo from "@assets/logo-studio-white.svg";

const isHome = Astro.url.pathname === "/";
---

<footer class="relative bg-grey-2" id="footer-section">
    <div class="absolute inset-0 max-w-7xl mx-auto pointer-events-none z-0">
        <div class="h-full w-full border-x border-blue-50 relative">
            {
                isHome && (
                    <div
                        data-footer-line
                        class="absolute left-1/2 top-0 h-[50vh] w-[1px] bg-blue-50 -translate-x-1/2 hidden md:block z-10"
                    >
                    </div>
                )
            }
        </div>
    </div>

    <!-- 2. The expanding background (starts fully hidden and clipped to a circle) -->
    <div data-footer-bg class="absolute inset-0 bg-blue-500 z-10"></div>

    <!-- 3. The Footer Content (z-20 to sit above the background) -->
    <div
        data-fade-in-content
        data-footer-content
        class="relative z-20 mx-auto w-full max-w-7xl px-8 md:px-6 xl:px-0 py-20 xl:min-h-screen flex flex-col justify-end"
    >
        <div
            class="flex flex-col xl:flex-1 xl:justify-between gap-16 md:gap-20 w-full"
        >
            <div class="flex flex-col items-center gap-8 text-center">
                <Logo class="w-40 md:w-60 h-auto" />
                <div class="flex flex-col gap-4 justify-center items-center">
                    <div
                        class="flex w-full flex-col items-center gap-2 lg:w-auto lg:justify-center"
                    >
                        <h2
                            class="font-display font-bold text-mobile-h1 text-grey-2 md:text-h1"
                        >
                            Let's expand your vision.
                        </h2>
                        <p class="text-body text-blue-50">
                            Tell us what you're working on.
                        </p>
                    </div>
                    <Button
                        label="Book a 15 min Call"
                        className="w-full max-w-[172px]"
                    >
                        <MeetIcon slot="icon" class="h-3 w-[14px]" />
                    </Button>
                </div>
            </div>
            <nav
                aria-label="Footer"
                class="flex flex-col border-y border-blue-400 md:flex-row md:justify-between"
            >
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            data-footer-nav-link
                            class="group relative w-full flex items-center justify-center border-b border-blue-400 p-8 text-body overflow-hidden md:border-b-0 md:border-r text-grey-2 last:md:border-r-0 transition-colors duration-300"
                        >
                            <span
                                data-footer-nav-bg
                                class="absolute left-1/2 top-1/2 h-0 w-0 -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-50 transition-[width,height] duration-500 ease-out pointer-events-none"
                            />
                            <span class="relative z-10 transition-colors duration-300 group-hover:text-blue-500">
                                {link.label}
                            </span>
                        </a>
                    ))
                }
            </nav>
            <div
                class="flex w-full flex-col items-center gap-4 md:flex-row md:justify-between md:items-center"
            >
                <ul class="flex items-center gap-2.5">
                    {
                        socials.map(({ href, label, icon: Icon }) => (
                            <li>
                                <a href={href} aria-label={label} class="block">
                                    <Icon />
                                </a>
                            </li>
                        ))
                    }
                </ul>
                <p class="text-medium-sm text-blue-50">
                    Copyright © Fayda Studio
                </p>
            </div>
        </div>
    </div>
</footer>
