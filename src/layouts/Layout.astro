---
import "@styles/global.css";
import Navbar from "@components/navigation/Navbar.astro";
import Footer from "@components/navigation/Footer.astro";
import Seo from "@components/seo/Seo.astro";
import PostHog from "@components/posthog.astro";

const {
	title,
	description,
	noindex,
}: { title?: string; description?: string; noindex?: boolean } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#2553FF" />
		<Seo {title} {description} {noindex} />
		<PostHog />
	</head>
	<body class="bg-grey-2 overflow-x-clip has-checked:overflow-hidden">
		<Navbar />
		<div
			id="sweep-strip"
			aria-hidden="true"
			class="pointer-events-none fixed inset-x-0 top-0 z-10 h-1 bg-blue-500"
		>
		</div>

		<!-- Ball -->
		<div
			data-floating-badge
			aria-hidden="true"
			class="pointer-events-none fixed left-1/2 top-1/2 z-[100] -translate-x-1/2 -translate-y-1/2 opacity-0"
		>
			<div
				data-badge-inner
				class="flex h-12 w-12 items-center justify-center drop-shadow-[0_0_15px_rgba(37,83,255,0.8)]"
			>
				<div
					data-badge-visual
					class="h-[20px] w-[20px] rounded-full bg-[#2553FF]"
				>
				</div>
			</div>
		</div>

		<div id="smooth-wrapper">
			<div id="smooth-content">
				<main class="">
					<slot />
				</main>
				<Footer />
			</div>
		</div>
		<script>
			import "@animations/index";

			document.addEventListener("click", (event) => {
				const contactCta = (event.target as HTMLElement).closest(
					"[data-posthog-contact-cta]",
				);
				if (!contactCta) return;

				window.posthog?.capture("contact_cta_clicked", {
					cta_label: contactCta.textContent?.trim(),
					placement: contactCta.closest("footer") ? "footer" : "page_content",
				});
			});
		</script>
	</body>
</html>
