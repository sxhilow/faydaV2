---
import "@styles/global.css";
import Navbar from "@components/Navbar.astro";
import Footer from "@sections/Footer.astro";
import Badge from "@assets/icons/badge.svg";

const {
	title = "Fayda Studio — Websites built from the ground up",
	description = "Custom-designed and developed websites for businesses that need more than another generic template.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#2553FF" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
	</head>
	<body class="bg-grey-2 overflow-x-clip has-checked:overflow-hidden">
		<Navbar />
		<div
			id="sweep-strip"
			aria-hidden="true"
			class="pointer-events-none fixed inset-x-0 top-0 z-10 h-1 bg-blue-500"
		>
		</div>
		<div
			data-floating-badge
			aria-hidden="true"
			class="pointer-events-none fixed left-1/2 top-1/2 z-[100] w-[76.8px] h-[76.8px] -translate-x-1/2 -translate-y-1/2 opacity-0"
		>
			<Badge />
		</div>
		<div id="smooth-wrapper">
			<div id="smooth-content">
				<main>
					<slot />
				</main>
				<Footer />
			</div>
		</div>
		<script>
			import "@animations/index";
		</script>
	</body>
</html>
