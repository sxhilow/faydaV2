---
import "@styles/global.css";
import Navbar from "@components/navigation/Navbar.astro";
import Footer from "@components/navigation/Footer.astro";
import Seo from "@components/seo/Seo.astro";

const {
	title,
	description,
	noindex,
}: { title?: string; description?: string; noindex?: boolean } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#2553FF" />
		<Seo {title} {description} {noindex} />
	</head>
	<body class="bg-grey-2 overflow-x-clip has-checked:overflow-hidden">
		<Navbar />
		<div
			id="sweep-strip"
			aria-hidden="true"
			class="pointer-events-none fixed inset-x-0 top-0 z-10 h-1 bg-blue-500"
		>
		</div>

		<!-- Ball -->
		<div
			data-floating-badge
			aria-hidden="true"
			class="pointer-events-none fixed left-1/2 top-1/2 z-[100] -translate-x-1/2 -translate-y-1/2 opacity-0"
		>
			<div
				data-badge-inner
				class="flex h-12 w-12 items-center justify-center drop-shadow-[0_0_15px_rgba(37,83,255,0.8)]"
			>
				<div
					data-badge-visual
					class="h-[20px] w-[20px] rounded-full bg-[#2553FF]"
				>
				</div>
			</div>
		</div>

		<div id="smooth-wrapper">
			<div id="smooth-content">
				<main class="">
					<slot />
				</main>
				<Footer />
			</div>
		</div>
		<script>
			import "@animations/index";
		</script>
	</body>
</html>
