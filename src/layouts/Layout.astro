---
import "@styles/global.css";
import Navbar from "@components/Navbar.astro";
import Footer from "@sections/Footer.astro";
const { title = "Fayda Studio — Websites built from the ground up", description = "Custom-designed and developed websites for businesses that need more than another generic template." } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#2553FF" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
	</head>
	<body class="bg-grey-2 overflow-x-clip has-checked:overflow-hidden">
		<Navbar />
		<div id="smooth-wrapper">
			<div id="smooth-content">
				<div class="h-24 lg:h-28" aria-hidden="true" />
				<main class="mx-auto w-full max-w-7xl md:px-6 xl:px-0">
					<slot />
				</main>
				<Footer />
			</div>
		</div>
		<script>
			import "@animations/index";
		</script>
	</body>
</html>
